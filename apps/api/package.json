{
  "name": "@kpblog/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.check.json",
    "test": "tsx --test --import ./tests/helpers/offline-env.ts tests/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/multipart": "^9.2.1",
    "@kpblog/contracts": "*",
    "@prisma/adapter-better-sqlite3": "7.9.0",
    "@prisma/client": "7.9.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.5",
    "jose": "^6.2.3",
    "mammoth": "^1.12.0",
    "pinyin-pro": "^3.29.4",
    "slugify": "^1.6.9"
  },
  "devDependencies": {
    "tsc-alias": "^1.8.16"
  }
}
