# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
**/.next/
**/out/
**/dist/

# production
/build
/backups/

# misc
.DS_Store
*.pem

# ZCode session state (plans, workflow drafts) — local tooling, never project data
/.zcode/

# Node diagnostic reports (crash dumps written to the process cwd, e.g. apps/api/)
report.[0-9]*.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local npm cache used when ~/.npm is not writable
/.npm-cache/

# local frontend research artifacts (screenshots, raw crawl data, chrome profile)
/.research/

# browser smoke runs use an isolated Next distDir; a killed run can leave it behind
/apps/web/tmp/

# Next resolves an absolute NEXT_DIST_DIR against apps/web, so passing an absolute
# path silently creates a build tree here (it once produced a 230 MB
# apps/web/eval-3321/ that got committed and pushed). Keep this as a safety net;
# next.config.ts now resolves such paths correctly instead.
/apps/web/eval-*/

# prisma
/prisma/dev.db
/prisma/dev.db-journal

# uploaded media
/apps/web/public/images/*
/apps/web/public/music/*
!/apps/web/public/images/home/
!/apps/web/public/images/home/*.webp
