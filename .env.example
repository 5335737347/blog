# =============================================================================
# 加载顺序与优先级（先读这里）
# =============================================================================
# 运行时已存在的进程环境变量优先级最高；文件按 .env.local → .env 的顺序补充。
#
# ⚠️ 空字符串同样算「已定义」。如果 .env.local 里写了 KEY=""，那么 .env 里的
#    KEY="值" 不会生效——应用会看到空值并回退到内置默认值。
#    想让 .env 提供某个值，请在 .env.local 里【整行删除】，而不是留空。
#
# 本文件是唯一可提交的模板。开发用 .env.local，生产用 .env，两者都不要提交。
# 新增变量时必须同步更新 docs/environment.md（check-docs.mjs 会校验）。

# =============================================================================
# Database
# =============================================================================
# SQLite database path. Relative file paths are resolved from the project root.
DATABASE_URL="file:./prisma/dev.db"

# =============================================================================
# Site
# =============================================================================
# Production origin, for example: https://example.com
SITE_URL=""

# Only needed by browser-rendered examples that require the public site origin.
# Usually keep this identical to SITE_URL.
NEXT_PUBLIC_SITE_URL=""

# Absolute or site-relative default social sharing image URL.
OG_IMAGE_URL=""

# =============================================================================
# Web / API processes
# =============================================================================
# Web listens on 3001. The browser keeps using same-origin /api/* URLs; Next.js
# proxies those requests to this private API address.
API_PORT="3002"
API_HOST="127.0.0.1"
API_INTERNAL_URL="http://127.0.0.1:3002"

# Optional absolute directory used for uploaded images and music. The current
# single-machine default is apps/web/public so existing /images and /music URLs
# remain compatible. Move this to object storage before multi-host deployment.
MEDIA_ROOT=""

# =============================================================================
# Authentication
# =============================================================================
# Required. Use a cryptographically random value of at least 32 characters.
# Example generator: openssl rand -hex 32
JWT_SECRET=""

# =============================================================================
# Administrator account / seed / login hardening
# =============================================================================
ADMIN_USERNAME="admin"
ADMIN_DISPLAY_NAME="管理员"

# Leave empty in development to generate and print a temporary password.
ADMIN_PASSWORD=""

# Destructive production seeding remains disabled unless explicitly set to true.
ALLOW_PRODUCTION_SEED=""

# Admin login lockout window, in minutes (default 15, capped at 1440).
#
# Continuous wrong passwords against an ADMIN account lock it for this long:
# during the window even the correct password is refused, and the refusal happens
# before bcrypt so a brute-force script cannot burn CPU. Regular accounts keep the
# looser rule (10 failures / 15 minutes). The lock is keyed by account, not by IP,
# so rotating IPs does not clear it.
ADMIN_LOGIN_LOCKOUT_MINUTES="15"

# =============================================================================
# Registration email — Resend HTTP API (preferred), SMTP (fallback)
# =============================================================================
# sendMail reads RESEND_API_KEY first; the SMTP block below is only used when it
# is empty. The two credential paths are independent: an HTTP API key goes in
# RESEND_API_KEY, NEVER in SMTP_PASSWORD (that mismatch produced a live AUTH 535
# and a 500 on register — see docs/registration-delivery.md).

# Resend API key (re_...). Works without enabling the SMTP relay in the dashboard.
RESEND_API_KEY=""
# Sender address; the domain must be verified in the Resend dashboard. Friendly
# name format works: "Kunpeng Blog <noreply@kpblog.cc>". Falls back to SMTP_FROM.
RESEND_FROM=""

# --- SMTP fallback path ---
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_STARTTLS=""
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Typical STARTTLS configuration:
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_STARTTLS="true"

# Allow AUTH PLAIN over an unencrypted SMTP connection (e.g. a local relay).
# When unset, the API refuses to send credentials over a plaintext connection.
SMTP_ALLOW_INSECURE=""

# Return the verification code in the API response instead of emailing it.
# Safe-by-default: only enable this on a development machine. Never enable it
# on a public deployment — anyone could then register any email address.
ALLOW_DEBUG_VERIFICATION_CODE=""

# =============================================================================
# Trusted proxy and rate limiting
# =============================================================================
# Disabled by default. Enable only when the API receives requests exclusively
# through trusted local infrastructure that overwrites the selected IP header.
TRUST_PROXY="false"
TRUST_PROXY_HEADER="x-real-ip"

# Cloudflare alternative:
# TRUST_PROXY_HEADER="cf-connecting-ip"

# Additional origins allowed to perform state-changing requests (CSRF guard).
#
# Normally you do NOT need this:
#   - SITE_URL is always allowed;
#   - localhost / 127.0.0.1 / [::1] are treated as equivalent automatically;
#   - in development, this machine's own interface addresses (including the
#     DHCP-assigned LAN IP you use to test from a phone) are allowed too,
#     so a changing lease never invalidates the config.
#
# Use it only for hosts that are none of the above, e.g. a temporary tunnel:
#   ALLOWED_ORIGINS="https://random-name.trycloudflare.com"
# It also feeds Next's allowedDevOrigins. Ignored in effect only for
# production-mode requests that do not match; production never relaxes.
ALLOWED_ORIGINS=""

# x-forwarded-for is deliberately NOT supported as a rate-limit identity.
#
# It is an appendable list header: with Nginx's common
# `proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for`, a client-supplied
# value stays at the left end, so the client would choose its own bucket key and
# could bypass per-IP limits entirely. Use a single-value header your proxy
# overwrites (x-real-ip / cf-connecting-ip) instead.

# =============================================================================
# Obsidian / command-line publishing
# =============================================================================
# Generate the API key from /admin/settings. Store the real value in .env.local.
KPBLOG_API_URL=""
KPBLOG_API_KEY=""

# Optional default: draft or publish. Command-line flags take precedence.
KPBLOG_PUBLISH_MODE=""

# =============================================================================
# Update script / PM2
# =============================================================================
# Process names are defined in ecosystem.config.cjs as blog-web and blog-api.

# =============================================================================
# Backups (npm run db:backup)
# =============================================================================
# How many timestamped SQLite snapshots to keep in backups/. Older files are
# deleted after each successful backup. Empty or unset means 10.
BACKUP_KEEP=""
# Same, for media snapshots (npm run media:backup). Media is far larger than the
# database, so fewer copies are kept by default. Empty or unset means 3.
MEDIA_BACKUP_KEEP=""
